# Copie este arquivo para .env e preencha com as credenciais reais.
# Nunca commitar o .env real (já está no .gitignore).

# --- Supabase ---
# Painel do projeto Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Banco de dados (Prisma) ---
# Painel do projeto Supabase > Project Settings > Database > Connection string
# Usar a "Connection pooling" (porta 6543) para DATABASE_URL
# Usar a "Direct connection" (porta 5432) para DIRECT_URL (usada pelo Prisma Migrate)
DATABASE_URL=
DIRECT_URL=

# --- Seed (opcional) ---
# Senha padrão das contas de teste criadas por `npm run seed`. Default: Agape@2026
SEED_SENHA=

# --- Notificações (Etapa 6) ---
# Painel do Resend > API Keys
RESEND_API_KEY=
# Remetente. Sem domínio verificado no Resend, só entrega ao e-mail dono da conta.
EMAIL_REMETENTE="Ministério Ágape <onboarding@resend.dev>"
# Segredo compartilhado com o Vercel Cron (header Authorization: Bearer <valor>).
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
# URL pública do deploy — usada só pelo script scripts/setup-pgcron-notificacoes.ts
APP_URL=
